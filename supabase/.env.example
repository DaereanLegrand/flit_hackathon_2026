# Copiar como supabase/.env.local únicamente en el servidor.
# Nunca confirmar el archivo .env.local ni claves reales en Git.
LASTFM_API_KEY=reemplazar

# API key para el endpoint LLM (opcional, puede estar vacío si el endpoint no requiere auth)
LLM_API_KEY=

# Modelo a usar (opcional, default: gemma)
LLM_MODEL=gemma

# MCP — Servidores externos para contexto del usuario
# Formato: nombre1=url1,nombre2=url2
# Ej: MCP_SERVER_URLS=flit-telegram-mcp=http://localhost:3100
MCP_SERVER_URLS=
